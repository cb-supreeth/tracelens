{
  "applicationId": "cb-plans",
  "applicationVersion": "LOCAL",
  "httpIncludePaths": ["/items", "/item_prices", "/item_families", "/custom_pricing_units"],
  "packages": ["com.chargebee.items"],
  "blacklistedNodes": ["ToStringBuilder"],
  "capturePayloads": false,
  "captureJdbcQueries": false,
  "captureJdbcParameters": false,
  "captureHttpQueryParameters": false,
  "captureHttpRequestBodies": false,
  "redactHttpPayloads": true,
  "maxTrackedEvents": 100000,
  "maxTrackedRequests": 100,
  "httpRetentionPercent": 75,
  "idleTtlMinutes": 30,
  "evictOnExport": false,
  "trackMethods": true,
  "trackExceptions": true,
  "instrumentExecutors": true,
  "instrumentMessaging": false,
  "captureMessagingBoundaries": true,
  "captureDataStoreBoundaries": true,
  "instrumentScheduled": false,
  "requireLabels": false,
  "distributedTracingEnabled": true,
  "httpClientCaptureEnabled": true,
  "httpPropagationAllowedDestinations": []
}
